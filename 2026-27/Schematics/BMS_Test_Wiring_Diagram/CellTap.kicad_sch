	(text "3. Source and find ~200 ohm resistors with 1/4 watt rating. Build the\nresistor ladder. Verify connections"
		(exclude_from_sim no)
		(at 174.752 113.792 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0dbd0e71-3e31-43fa-ad3d-439eb2854e39")
	)
	(text "2. Create a 9 lead wire harness. Populate positions Cell1- to Cell6+\nas well as GND and CELL_TOP"
		(exclude_from_sim no)
		(at 99.568 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "35a02d16-ca90-4514-b280-72add21ba7ee")
	)
	(text "5. Connect GND and Cell1- to PowerSupply-.\n   Connect CELL_TOP and Cell6+ to PowerSupply+.\n   Ensure output is off.\n   Set voltage to 23V. Set current limit to 50mA. If hit, set to 80mA"
		(exclude_from_sim no)
		(at 93.472 152.908 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "39f3e241-b248-47cf-bc6f-5227e988093a")
	)
	(text "7. TIe 6 to PowerSupply Negative terminal. get another power supply\n   and tie that negative terminal to this one. use power supply+\n	to power enepaq temp sensors."
		(exclude_from_sim no)
		(at 99.06 183.134 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "446d0183-51db-427a-a2b4-1b7672d81307")
	)
	(text "12 cell option"
		(exclude_from_sim no)
		(at 84.582 69.342 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4ce0fbe3-d699-4cc7-8899-c03bdf916d3e")
	)
	(text "1. Ensure JP3 / R1 is soldered and JP4 /R77 is left unsoldered.\nThis configures the board for 6 cells as opposed to 12.\nBoth are located on back layer."
		(exclude_from_sim no)
		(at 124.968 23.622 0)
		(effects
			(font
				(size 1.27 1.27)
			)

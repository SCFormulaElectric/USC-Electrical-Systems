	(text "TEMP SENSORS"
		(exclude_from_sim no)
		(at 419.1 144.78 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "21b899df-01f8-4626-8f2e-f2865ee15c0b")
	)
	(text "upper bound: Rnpn = ((Min VModule) - (VCollector)) / (Max peak current)\nlower bound: depends on target power dissipation\n\nselect 2 different Rpn resistors for 6 cells vs 12 cells\n\n6 cells:\nupper bound = (2.5*6 - 8) / 20mA = 350 Ohms\nat max V (4.2*6), with 350 ohm resistor, burns 140mW, BJT will burn max 330 mW\n\n12 cells:\nupper bound = (2.5*12 - 8) / 20mA = 1.1 kOhms\nat max V (4.2*12), with 1.1 kOhm resistor, burns 440mW, BJT will burn max 568mW"
		(exclude_from_sim no)
		(at 34.925 92.075 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "244f34b2-1c6e-4bfd-9408-2aa682362ae6")
	)
	(text "CELL BALANCING"
		(exclude_from_sim no)
		(at 40.64 248.92 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "27ca6b00-1332-41cd-8667-69f933d9e35e")
	)
	(text "CELL TAPS"
		(exclude_from_sim no)
		(at 271.78 248.92 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "2d89b3c6-6669-4bee-a91a-1f8219c536df")
	)
	(text "worse RdsonQCB = 1.45 Ohms\nwith 10 ohm resistors\nno consecutive: Icb = 4.2/(10*2 + 1.45) = .195A\npower through resistors = .383 W\nat worse case ambient temp (90C), it's a 80% derating (source-Digikey)\nuse 1/2 W resistors, add plenty of copper beneath to sink heat"
		(exclude_from_sim no)
		(at 143.51 306.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "3db893ae-a881-473e-b150-962d642ec3f0")
	)
	(text "20mA startup inrush current"
		(exclude_from_sim no)
		(at 48.514 76.962 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)

	)
	(text "NPN voltage rating = 50.4 - 5.9 + 30 = 74.5V\n"
		(exclude_from_sim no)
		(at 58.42 66.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "810d3f55-f079-4f04-92f2-f536be8522c6")
	)
	(text "ILDOIN < 10mA\npreregulation circuit power < ~45V*10mA = 450mW\ngive 50% margin, 675mW"
		(exclude_from_sim no)
		(at 34.798 71.628 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "84ea8a83-7867-46d9-976c-4965b8815349")
	)
	(text "these captacitors need to be 2.2nF and rated \nfor 2x the TS voltage and  automotive qualified. \nUse of a capacitor of up to 5.6nF for this \nisolation is possible"
		(exclude_from_sim no)
		(at 98.552 226.314 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "90cf4f0f-bd22-4590-9a7a-bd4450dc9a5d")
	)
	(text "cell tap fuses should be off board\n\nfilter resistors might blow before fuses at lower currents\nincrease copper under resistors to better sink heat\nmaximally thermally relieve the fuses"
		(exclude_from_sim no)
		(at 262.89 288.29 0)
		(effects
			(font

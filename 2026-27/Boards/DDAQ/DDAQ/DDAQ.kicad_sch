				(size 1.27 1.27)
			)
		)
		(uuid "61b368f3-6d58-480a-9a60-7a23591ae615")
	)
	(text "Per channel: AIx + dedicated"
		(exclude_from_sim no)
		(at 366.522 437.642 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "67b72ca4-724a-4787-a105-b11cce9dbc13")
	)
	(text "split termination helps \nwith common mode noise"

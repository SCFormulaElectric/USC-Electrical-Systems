			)
		)
		(uuid "1e239ca9-7ad6-461a-ba2e-c6223c2f3f09")
	)
	(text "CAN TERMINATION (split 2x60R + 4.7nF): bridge all 3 pads to terminate.\nJP1 = CAN1, OPEN by default (bus passes through J3 29-32).\nJP2 = CAN2, BRIDGED by default (this board ends CAN2). Open = both 60R legs float."
		(exclude_from_sim no)
		(at 589.28 632.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "26ab3265-4af6-4872-9d59-c05a1e8b659f")
	)
	(text "CAN1"
		(exclude_from_sim no)
		(at 310.642 92.964 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "3c71040f-a999-427a-ba50-638bc56bc03c")
	)
	(text "J3 ANALOG INPUTS (TE 3-6437285-2, pins 1-32)"
		(exclude_from_sim no)
		(at 366.522 426.212 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3e406944-ebdd-4368-a309-002c678b2e06")
	)
	(text "Input RC: 1k + 100nF = 1.6 kHz (anti-alias for oversampling only).\nFirmware scans ADS8688 at ~10 kSPS/ch, applies per-channel digital LPF\n(e.g. 100 Hz shocks, 200 Hz lasers), then decimates to the CAN rate.\nThis replaces the spec's 150-200 Hz analog corner."
		(exclude_from_sim no)
		(at 295.148 443.484 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "556b0f0b-183d-46ec-b304-79af22f5914a")
	)
	(text "12V indicator"
		(exclude_from_sim no)
		(at 98.806 734.06 0)
		(effects

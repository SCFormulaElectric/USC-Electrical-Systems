	)
	(text "Micro SD"
		(exclude_from_sim no)
		(at 519.176 132.588 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "baa0a94d-714e-431b-bd5a-e8e35705d998")
	)
	(text "Firmware:\n- ISM330DHCX: set CTRL4_C.I2C_disable = 1 at init (shares the SPI bus; CS high otherwise = I2C mode).\n- BMP581 switches to SPI on the first CSB falling edge: do one dummy read first.\nLayout:\n- IMU near the board mounting point / centre; mark X/Y/Z axes on silkscreen.\n- Barometer away from the LM5175 / LMR33630 / TPS563300 hot spots; enclosure needs a vent membrane over it."
		(exclude_from_sim no)
		(at 365.76 726.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c2793ae5-7245-4db1-abe2-4c74c9b19ec3")
	)
	(text "D42/D43 diode-OR: battery (+5V) or USB VBUS feeds the 3.3 V LDO (U4); neither can back-feed the other.\nUSB alone runs only the 3.3 V side (MCU, SD, IMU, baro, LEDs). Firmware: detect it from the rail monitors\n(PC2 VIN, PB2 5V) and skip ADC / CAN / sensor-supply init. Enable the USB D+ pull-up only while PA9 sees VBUS.\nU4 = TLV1117LV33 (dropout ~90 mV @ 200 mA): ~1 V margin from ~4.4-4.6 V in. VIN max 5.5 V - feed only from +5V / VBUS."
		(exclude_from_sim no)
		(at 443.23 810.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "cb740870-c9dd-4ac2-87c3-7c95495a8265")
	)
	(text "Analog Inputs with RC filtering & TVS Diode OV protection"
		(exclude_from_sim no)
		(at 298.704 463.296 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "cd6c6eb1-3451-48e0-9b57-f11081ab1cbd")
	)
	(text "IMU + BAROMETER (SPI3: PC10 SCK / PC11 MISO / PC12 MOSI, AF6)"
		(exclude_from_sim no)
		(at 365.76 591.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d87861ba-683c-46eb-b164-391d1628dc00")
	)
	(text "SD POWER: PD9 low = card powered (Q7, ~1 ms soft start; pulled off during reset).\nBefore power-off drive SPI2 SCK/MOSI/CS low (pull-ups are on SD_VDD), wait >= 100 ms before re-enabling.\nPD8 (SPI2_CD_PD8) reserved for card detect: J1 symbol/footprint has no detect-switch pins - check the\nMolex 47309-2651 drawing before wiring it."
		(exclude_from_sim no)
		(at 589.28 718.82 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "df56bcce-778e-41ad-a7a2-a17a6ea2817b")
	)
